{
  "expo": {
    "name": "Élixir",
    "slug": "elixir-rituals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elixir",
    "description": "A considered space for daily rituals and meaningful tasks.",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boaz.to"
    },
    "android": {
      "package": "com.boaz.to",
      "adaptiveIcon": {
          "backgroundColor": "#181110",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#181110"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
